<Window x:Class="MediFormManager.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediForm Manager"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="MediForm Manager"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#172033"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Admin"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>

                    <Button Content="Logout"
                            Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0">

                <StackPanel Margin="16,24">

                    <Button Content="Dashboard"
                            Click="DashboardButton_Click"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6"/>

                    <Button Content="Forms"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6"/>

                    <Button Content="Designer"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6"/>

                    <Button Content="Preview / Test"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Margin="0,0,0,6"/>

                    <Button Content="Users"
                            Click="UsersButton_Click"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"/>
                </StackPanel>
            </Border>

            <!-- Page Slot -->
            <Border Grid.Column="1"
                    Background="#F4F6F8">

                <ContentControl x:Name="MainContent"/>
            </Border>
        </Grid>
    </Grid>
</Window>