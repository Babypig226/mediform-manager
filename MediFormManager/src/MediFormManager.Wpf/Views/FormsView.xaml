<UserControl x:Class="MediFormManager.Wpf.Views.FormsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- SelectedForm이 null인지 확인 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Form Library 카드 -->
        <Style x:Key="FormListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 공통 액션 버튼 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F4F6F8" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Forms"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#172033"/>

                <TextBlock Text="Manage forms and versions"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#64748B"/>
            </StackPanel>
        </Grid>

        <!-- Main layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FormLibraryColumn" Width="*"/>
                <ColumnDefinition x:Name="VersionColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Form Library -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,12,0">

                <DockPanel>

                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,16">

                        <TextBlock Text="Form Library"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Select a form to view its versions."
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <ListBox x:Name="FormList"
                             ItemsSource="{Binding Forms}"
                             SelectedItem="{Binding SelectedForm, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FormListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="FormList_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FormCode}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#172033"/>

                                        <TextBlock Text="{Binding FormName}"
                                                   Margin="0,6,0,0"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="#475569"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="9,5"
                                            CornerRadius="12"
                                            Background="#F1F5F9"
                                            VerticalAlignment="Top">

                                        <TextBlock Text="Form"
                                                   FontSize="11"
                                                   Foreground="#64748B"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT: Version Panel -->
            <Border x:Name="VersionPanel"
                    Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="12,0,0,0"
                    Visibility="Collapsed">

                <DockPanel>

                    <!-- Panel Header -->
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Form Versions"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Width="28"
                                    Height="28"
                                    Click="CloseVersions_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedForm.FormCode}"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding SelectedForm.FormName}"
                                   Margin="0,3,0,0"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#334155"/>
                    </StackPanel>

                    <!-- Version Cards -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,12">

                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#172033">
                                                    <Run Text="Version "/>
                                                    <Run Text="{Binding Version}"/>
                                                </TextBlock>

                                                <Border Grid.Column="1"
                                                        Background="#E2E8F0"
                                                        CornerRadius="10"
                                                        Padding="9,4">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"
                                                               Foreground="#475569"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,16,0,0">

                                                <Button Content="Preview"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        Click="PreviewVersion_Click"/>

                                                <Button Content="Edit"
                                                        Click="EditVersion_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                    BasedOn="{StaticResource PrimaryButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                 </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>

        <!-- Error message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="#DC2626"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
